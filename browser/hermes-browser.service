# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Run Chromium as a localhost-only CDP backend for Hermes Built-in Browser.
[Unit]
Description=Hermes local Chromium CDP backend
After=network.target
ConditionPathExists=/snap/bin/chromium

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/snap/chromium/common/hermes-agent-profile
ExecStart=/snap/bin/chromium --headless=new --no-first-run --no-default-browser-check --remote-debugging-address=127.0.0.1 --remote-debugging-port=19222 --user-data-dir=%h/snap/chromium/common/hermes-agent-profile about:blank
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
