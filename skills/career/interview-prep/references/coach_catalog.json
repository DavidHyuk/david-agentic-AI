  "system_design": [
    {
      "id": "delivery-framework",
      "name": "Delivery framework: requirements and estimation",
      "target_minutes": 50,
      "url": "https://www.hellointerview.com/learn/system-design/in-a-hurry/delivery",
      "prerequisites": [],
      "focus": [
        "Separate functional requirements from measurable quality targets.",
        "Explain the sequence from requirements to interfaces, architecture, and deep dives.",
        "Estimate average and peak request rates and storage from explicit assumptions.",
        "Use estimates to justify one design decision rather than calculating everything."
      ],
      "exercise": "Spend 20 minutes reading, 20 minutes framing a daily study notification service, and 10 minutes explaining your requirements and estimates aloud.",
      "hermes_connection": "Use Hermes daily Telegram delivery as the example: define delivery latency, missed-message behavior, and expected traffic."
    },
    {
      "id": "url-shortener",
      "name": "API design + data modeling: Design a URL Shortener",
      "target_minutes": 55,
      "url": "https://www.hellointerview.com/learn/system-design/problem-breakdowns/bitly",
      "prerequisites": [
        "delivery-framework"
      ],
      "focus": [
        "Specify create-link and redirect APIs, including error cases.",
        "Define the link record, key, expiry, and lookup index.",
        "Explain code uniqueness and collision handling.",
        "Trace a redirect and justify caching and storage choices."
      ],
      "exercise": "Read for 20 minutes, sketch APIs and records for 20 minutes, then defend the redirect path for 15 minutes.",
      "hermes_connection": "Compare stable short-link IDs with the canonical paper URLs Hermes includes in Telegram; distinguish identifiers from delivery records."
    },
    {
      "id": "key-technologies",
      "name": "Key technologies: cache, queue, load balancer, DB replication",
      "target_minutes": 55,
      "url": "https://www.hellointerview.com/learn/system-design/in-a-hurry/key-technologies",
      "prerequisites": [
        "url-shortener"
      ],
      "focus": [
        "Explain cache placement, invalidation, and stale reads.",
        "Describe how a queue buffers work and how workers acknowledge it.",
        "Explain routing and health checks at a load balancer.",
        "Explain primary/replica writes, replication lag, and failover."
      ],
      "exercise": "Study the building blocks for 25 minutes, draw their request and background-work paths for 20 minutes, and explain a failure in each path for 10 minutes.",
      "hermes_connection": "Start with the current Hermes cron and watchdog; propose when separate queued workers and replicated storage would become useful, without claiming they already exist."
    },
    {
      "id": "notification-system",
      "name": "Design a Notification System",
      "target_minutes": 50,
