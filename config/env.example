# Copy the values you need into ~/.hermes/.env (chmod 600). NEVER commit real secrets.
# install.sh seeds the local endpoint key automatically.

# vLLM endpoint auth. vllm serve accepts any Bearer token by default (or none).
# An empty string is fine; set a real key if you add --api-key to run_hermes_model.sh.
OPENAI_API_KEY=sk-local-no-key-required

# Optional: increase Skills Hub GitHub rate limit (60/hr -> 5000/hr).
# GITHUB_TOKEN=

# Cron scheduler hardening (optional; config.fragment.yaml also sets max_parallel_jobs).
# HERMES_CRON_MAX_PARALLEL=1
# HERMES_CRON_TIMEOUT=600

# WhatsApp gateway is configured interactively via `hermes gateway setup`
# (QR-code device link). No static token is stored here.
