# Copy the values you need into ~/.hermes/.env (chmod 600). NEVER commit real secrets.
# install.sh seeds the local endpoint key automatically.

# vLLM endpoint auth. vllm serve accepts any Bearer token by default (or none).
# An empty string is fine; set a real key if you add --api-key to run_hermes_model.sh.
OPENAI_API_KEY=sk-local-no-key-required

# Optional: increase Skills Hub GitHub rate limit (60/hr -> 5000/hr).
# GITHUB_TOKEN=

# Cron scheduler hardening (optional; config.fragment.yaml also sets max_parallel_jobs).
# HERMES_CRON_MAX_PARALLEL=1
# HERMES_CRON_TIMEOUT=600

# Paper ingestion runtime paths. Defaults already match this project, so these
# are only needed when relocating the catalog or legacy migration source.
# PAPERS_DB_PATH=~/.hermes/data/papers/papers.db
# PAPERS_LEGACY_DB_PATH=/home/david/workspace/Subscribe-Papers/data/papers.db

# WhatsApp gateway is configured interactively via `hermes gateway setup`
# (QR-code device link). No static token is stored here.

# Kakao i Open Builder skill server. Generate a secret path with:
#   python3 ~/.hermes/scripts/kakao_webhook.py --generate-path
# Use the same path after your HTTPS tunnel domain in the Open Builder Skill URL.
# KAKAO_WEBHOOK_PATH=/kakao/replace-with-a-long-random-secret
# KAKAO_WEBHOOK_PORT=8787
# Optional after a test message: comma-separated Kakao user IDs allowed to submit
# tutor feedback. Leave empty only while initially discovering the teacher's ID.
# KAKAO_ALLOWED_USER_IDS=
# Private observed-sender state used by --approve-latest-sender.
# KAKAO_SENDER_STATE_PATH=~/.hermes/data/english/kakao-senders.json
