# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: serve private photo ingestion and sequential Qwen3.6 assessment locally.
[Unit]
Description=ClawGram local photo assessment service
After=network-online.target hermes-vllm.service
Wants=network-online.target
Requires=hermes-vllm.service

[Service]
Type=simple
WorkingDirectory=/home/david/workspace/ClawGram
EnvironmentFile=-%h/.config/clawgram/worker.env
ExecStart=/home/david/miniconda3/envs/clawgram/bin/python -m clawgram.assessment_service --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/workspace/ClawGram/data

[Install]
WantedBy=default.target
