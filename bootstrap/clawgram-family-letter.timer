# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: check every Saturday at 02:00; the scheduler admits one job per 14-day slot.
[Unit]
Description=Biweekly ClawGram family-letter schedule gate

[Timer]
OnCalendar=Sat *-*-* 02:00:00
Persistent=true
RandomizedDelaySec=10min
Unit=clawgram-family-letter.service

[Install]
WantedBy=timers.target
