# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: run paper metadata ingestion every morning before the Hermes digest.
[Unit]
Description=Daily Hermes paper metadata ingestion

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=true
RandomizedDelaySec=2min
Unit=hermes-papers-ingest.service

[Install]
WantedBy=timers.target
