# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: collect paper metadata independently of interactive Hermes sessions.
[Unit]
Description=Hermes paper metadata ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.hermes/scripts/papers_ingest.py --db %h/.hermes/data/papers/papers.db --legacy-db /home/david/workspace/Subscribe-Papers/data/papers.db
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.hermes/data/papers
