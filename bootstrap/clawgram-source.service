# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: collect a queued job's media before the assessment worker can claim it.
[Unit]
Description=ClawGram fail-closed media source collection
After=network-online.target clawgram-google-photos-browser.service
Wants=network-online.target clawgram-google-photos-browser.service

[Service]
Type=oneshot
WorkingDirectory=/home/david/workspace/ClawGram
EnvironmentFile=-%h/.config/clawgram/worker.env
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/david/miniconda3/envs/clawgram/bin/python -m clawgram.collect_sources
ExecStartPost=/usr/bin/systemctl --user start --no-block clawgram-worker.service
TimeoutStartSec=6h
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/workspace/ClawGram/data %h/.hermes/profiles/clawgram
