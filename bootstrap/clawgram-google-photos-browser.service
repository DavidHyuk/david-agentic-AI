# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: isolate Google Photos authentication and CDP from David's browser.
[Unit]
Description=ClawGram dedicated Google Photos Chromium CDP backend
After=network-online.target
Wants=network-online.target
ConditionPathExists=/snap/bin/chromium

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/snap/chromium/common/clawgram-google-photos-profile
ExecStart=/snap/bin/chromium --headless=new --no-first-run --no-default-browser-check --remote-debugging-address=127.0.0.1 --remote-debugging-port=19223 --user-data-dir=%h/snap/chromium/common/clawgram-google-photos-profile about:blank
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
