# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: serve token-protected family-letter review and Android share handoff.
[Unit]
Description=ClawGram family-letter review service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/david/workspace/ClawGram
EnvironmentFile=-%h/.config/clawgram/worker.env
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/david/miniconda3/envs/clawgram/bin/uvicorn clawgram.review_app:app --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/workspace/ClawGram/data %h/.hermes/profiles/clawgram

[Install]
WantedBy=default.target
