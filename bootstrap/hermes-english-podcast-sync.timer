# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: pre-download a podcast transcript daily before the 09:15 lesson.
[Unit]
Description=Daily English Goal Podcast transcript preparation

[Timer]
OnCalendar=*-*-* 08:25:00
Persistent=true
AccuracySec=1min
Unit=hermes-english-podcast-sync.service

[Install]
WantedBy=timers.target
