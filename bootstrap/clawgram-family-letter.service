# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: enqueue a due family-letter job without occupying a Hermes cron worker.
[Unit]
Description=ClawGram biweekly family-letter enqueue

[Service]
Type=oneshot
WorkingDirectory=/home/david/workspace/ClawGram
ExecStart=/home/david/miniconda3/envs/clawgram/bin/python -m clawgram.scheduler --minimum-gap-days 13
ExecStartPost=/usr/bin/systemctl --user start --no-block clawgram-source.service
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/workspace/ClawGram/data
