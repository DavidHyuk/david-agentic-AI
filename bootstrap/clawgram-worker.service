# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: run one isolated ClawGram queue item outside Hermes cron.
[Unit]
Description=ClawGram one-shot curation worker
After=network-online.target clawgram-assessment.service clawgram-review.service
Wants=network-online.target clawgram-assessment.service clawgram-review.service

[Service]
Type=oneshot
WorkingDirectory=/home/david/workspace/ClawGram
EnvironmentFile=-%h/.config/clawgram/worker.env
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/david/miniconda3/envs/clawgram/bin/python -m clawgram.worker
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=1 78
TimeoutStartSec=6h
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/workspace/ClawGram/data %h/.hermes/profiles/clawgram
