# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: check Hermes cron health frequently enough to prevent silent outages.
[Unit]
Description=Run the Hermes cron watchdog every five minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=hermes-cron-watchdog.service

[Install]
WantedBy=timers.target
