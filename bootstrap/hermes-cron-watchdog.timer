# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: detect stalled Observatory chat and cron health before a user waits long.
[Unit]
Description=Run the Hermes cron watchdog every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=hermes-cron-watchdog.service

[Install]
WantedBy=timers.target
