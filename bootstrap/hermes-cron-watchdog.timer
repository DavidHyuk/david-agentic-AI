# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: check gateway health on a staggered cadence outside scheduled job minutes.
[Unit]
Description=Run the Hermes cron watchdog every five minutes

[Timer]
OnBootSec=1min
OnCalendar=*-*-* *:03/5:00
AccuracySec=15s
Unit=hermes-cron-watchdog.service

[Install]
WantedBy=timers.target
