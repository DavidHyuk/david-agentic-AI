# Purpose: detect a stalled Hermes cron tick and recover its gateway.
[Unit]
Description=Hermes cron scheduler health check and recovery
After=hermes-gateway.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.hermes/scripts/cron_health.py --lock-stale-minutes 20 --restart
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
