# __author__ = 'David Choi (bestshoot21@gmail.com)'
# Purpose: detect stalled David and English cron schedulers and recover their gateways.
[Unit]
Description=Hermes cron scheduler health check and recovery
After=hermes-gateway.service hermes-gateway-english.service

[Service]
Type=oneshot
SuccessExitStatus=1
Environment="PATH=%h/.local/bin:%h/miniconda3/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 %h/.hermes/scripts/connection_health.py --home %h/.hermes --notify
ExecStart=/usr/bin/python3 %h/.hermes/scripts/cron_health.py --lock-stale-minutes 20 --check-api --restart --notify-restarts --retry-failed-once --inference-admission-url http://127.0.0.1:8003/admission
ExecStart=/usr/bin/python3 %h/.hermes/scripts/cron_health.py --hermes-home %h/.hermes/profiles/english --profile english --gateway-service hermes-gateway-english.service --skip-missing-home --lock-stale-minutes 20 --restart --notify-restarts --retry-failed-once --inference-admission-url http://127.0.0.1:8003/admission
TimeoutStartSec=330
NoNewPrivileges=true
PrivateTmp=true
