# Purpose: keep the Hermes Qwen3.8 Flash-Next endpoint alive across logouts/reboots.
[Unit]
Description=Hermes Qwen3.8 Flash-Next 4-bit Model Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/David-Agent
ExecStartPre=/usr/bin/test -x %h/workspace/llama.cpp/build-qwen38/bin/llama-server
ExecStart=/usr/bin/bash %h/workspace/David-Agent/local-model/run_flash_next.sh
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
KillSignal=SIGINT
TimeoutStartSec=900
TimeoutStopSec=90
LimitNOFILE=1048576

[Install]
WantedBy=default.target
